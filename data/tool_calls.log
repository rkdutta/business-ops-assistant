2026-08-22 10:51:54,647 run_analysis_script({'tables': ['invoices'], 'script': 'import pandas as pd\nfrom datetime import datetime\n\n# Read invoice data\ninvoices_df = pd.read_csv(\'invoices.csv\')\n\n# Convert date columns to datetime\ninvoices_df[\'issued_date\'] = pd.to_datetime(invoices_df[\'issued_date\'])\ninvoices_df[\'due_date\'] = pd.to_datetime(invoices_df[\'due_date\'])\n\n# Calculate current date for overdue determination\nas_of_date = datetime.now()\n\n# Calculate revenue by month (using issued_date)\ninvoices_df[\'issue_month\'] = invoices_df[\'issued_date\'].dt.to_period(\'M\')\nmonthly_revenue = invoices_df.groupby(\'issue_month\')[\'amount\'].sum().reset_index()\nmonthly_revenue[\'issue_month\'] = monthly_revenue[\'issue_month\'].astype(str)\n\n# Calculate overdue amount (invoices where due_date < current date and status indicates unpaid)\noverdue_df = invoices_df[(invoices_df[\'due_date\'] < as_of_date) & (invoices_df[\'status\'].str.lower().str.contains(\'unpaid|pending|open\') | invoices_df[\'status\'].isna())]\ntotal_overdue = overdue_df[\'amount\'].sum()\n\n# Print results\nprint("=== Total Invoice Revenue by Month ===")\nfor _, row in monthly_revenue.iterrows():\n    print(f"{row[\'issue_month\']}: ${row[\'amount\']:.2f}")\n\nprint(f"\\n=== Total Overdue Amount ===")\nprint(f"${total_overdue:.2f}")\nprint(f"\\nOverdue invoices count: {len(overdue_df)}")'})
