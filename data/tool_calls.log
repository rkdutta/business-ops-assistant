2026-08-22 10:52:59,483 run_analysis_script({'tables': ['invoices'], 'script': '#!/usr/bin/env python3\nimport pandas as pd\nfrom datetime import datetime\n\n# Read the invoices CSV file\ninvoices_df = pd.read_csv(\'invoices.csv\')\n\n# Convert date columns to datetime\ninvoices_df[\'issued_date\'] = pd.to_datetime(invoices_df[\'issued_date\'])\ninvoices_df[\'due_date\'] = pd.to_datetime(invoices_df[\'due_date\'])\n\n# Calculate month for grouping (year-month format)\ninvoices_df[\'month\'] = invoices_df[\'issued_date\'].dt.to_period(\'M\').astype(str)\n\n# Calculate total invoice revenue by month\nmonthly_revenue = invoices_df.groupby(\'month\')[\'amount\'].sum().reset_index()\nmonthly_revenue.columns = [\'Month\', \'Total Revenue\']\n\n# Calculate total overdue amount\noverdue_amount = invoices_df[invoices_df[\'status\'].str.lower() == \'overdue\'][\'amount\'].sum()\n\n# Prepare results\nprint("=== Monthly Invoice Revenue ===")\nfor _, row in monthly_revenue.iterrows():\n    print(f"{row[\'Month\']}: ${row[\'Total Revenue\']:.2f}")\n\nprint("\\n=== Overdue Amount Summary ===")\nprint(f"Total Overdue Amount: ${overdue_amount:.2f}")\n\n# Also provide a combined view\nprint("\\n=== Combined Summary ===")\nprint("Monthly Revenue:")\nfor _, row in monthly_revenue.iterrows():\n    print(f"  {row[\'Month\']}: ${row[\'Total Revenue\']:.2f}")\nprint(f"  Total Overdue: ${overdue_amount:.2f}")'})
